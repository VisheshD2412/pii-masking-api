# Application
APP_NAME=PII Masking API
APP_VERSION=1.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Validation
MAX_TEXT_LENGTH=5000
LARGE_TEXT_THRESHOLD=2000

# Cache
CACHE_ENABLED=true
CACHE_MAX_SIZE=1024

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT=60/minute

# CORS (comma-separated or * for all)
CORS_ORIGINS=*

# Presidio / spaCy
SPACY_MODEL=en_core_web_sm
DEFAULT_LANGUAGE=en
SCORE_THRESHOLD=0.35

# Logging
LOG_LEVEL=INFO
LOG_REQUESTS=true

# Monitoring
PROMETHEUS_ENABLED=true

# Streamlit UI (optional)
PII_API_URL=http://localhost:8000
